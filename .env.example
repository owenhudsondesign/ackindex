# AckIndex Environment Variables
# Copy this file to .env.local and fill in your actual values

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# OPENAI CONFIGURATION
# ==============================================================================
# Get your API key from: https://platform.openai.com/api-keys
# Required for: Embeddings generation, chat responses

OPENAI_API_KEY=sk-proj-your-openai-key-here

# ==============================================================================
# APIFY CONFIGURATION
# ==============================================================================
# Get your API token from: https://console.apify.com/account/integrations
# Required for: URL scraping, PDF extraction, YouTube video processing

APIFY_API_TOKEN=apify_api_your-token-here
APIFY_ACTOR_ID=legible_radish/ackindex-3
STAGEHAND_ACTOR_ID=legible_radish/stagehand-nantucket-scraper
ENABLE_STAGEHAND_AUTO_DETECT=true

# YouTube Orchestrator - Processes YouTube videos through transcription pipeline
YOUTUBE_ORCHESTRATOR_ACTOR_ID=legible_radish/youtube-meetings-orchestrator

# ==============================================================================
# YOUTUBE CONFIGURATION
# ==============================================================================
# YouTube Data API v3 key from: https://console.cloud.google.com/apis/credentials
# Required for: YouTube video discovery and metadata (transcripts fetched via public API)

YOUTUBE_API_KEY=your-youtube-api-key-here

# ==============================================================================
# GLADIA TRANSCRIPTION API
# ==============================================================================
# Get your API key from: https://app.gladia.io
# Required for: Audio/video transcription from YouTube and other sources
# Handles videos up to 120 minutes automatically

GLADIA_API_KEY=your-gladia-api-key-here

# ==============================================================================
# ASSEMBLYAI TRANSCRIPTION API
# ==============================================================================
# Get your API key from: https://www.assemblyai.com/
# Optional: Used for manual processing of long videos (>120 minutes)
# Handles videos up to 10 hours

ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here

# ==============================================================================
# SENDGRID EMAIL CONFIGURATION
# ==============================================================================
# Get your API key from: https://app.sendgrid.com/settings/api_keys
# Required for: Contact form, admin notifications

SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
CONTACT_EMAIL=your-contact-email@example.com

# ==============================================================================
# STRIPE CONFIGURATION
# ==============================================================================
# Get these from: https://dashboard.stripe.com/apikeys
# Required for: Premium subscriptions, payments

STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key-here
STRIPE_PREMIUM_PRICE_ID=price_your-price-id-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ==============================================================================
# CRON JOB CONFIGURATION
# ==============================================================================
# Generate a random secret for cron job authentication
# Example: openssl rand -base64 32

CRON_SECRET=your-random-secret-here

# ==============================================================================
# UPSTASH REDIS CONFIGURATION
# ==============================================================================
# Get these from: https://console.upstash.com/redis
# Required for:
#   - BullMQ job queues (scraping, embedding generation)
#   - Vercel KV caching (user profiles, search queries, embeddings)
# Note: Both BullMQ and Vercel KV use the SAME Redis instance

REDIS_URL=redis://default:your-password@your-redis.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-rest-token-here

# Vercel KV uses the same Upstash credentials
KV_REST_API_URL=${UPSTASH_REDIS_REST_URL}
KV_REST_API_TOKEN=${UPSTASH_REDIS_REST_TOKEN}
KV_REST_API_READ_ONLY_TOKEN=${UPSTASH_REDIS_REST_TOKEN}

# ==============================================================================
# GLITCHTIP ERROR MONITORING (Sentry-compatible)
# ==============================================================================
# Get your DSN from: https://glitchtip.com (after creating a project)
# Required for: Error tracking, performance monitoring
# See GLITCHTIP-SETUP.md for detailed setup instructions

NEXT_PUBLIC_SENTRY_DSN=https://your-key@app.glitchtip.com/your-project-id

# Optional: For uploading source maps (helps with debugging)
# Get auth token from GlitchTip: Settings → Auth Tokens
SENTRY_URL=https://app.glitchtip.com
SENTRY_ORG=your-glitchtip-org-slug
SENTRY_PROJECT=ackindex
SENTRY_AUTH_TOKEN=glitchTip_your_auth_token_here

# ==============================================================================
# NOTES
# ==============================================================================
#
# 1. NEVER commit .env.local to git (it's in .gitignore)
# 2. For production (Vercel), set these in: Dashboard → Settings → Environment Variables
# 3. For Railway worker, set these in: Dashboard → Variables tab
# 4. Use different values for development vs. production
# 5. Stripe: Use test keys (sk_test_*, pk_test_*) for development
# 6. See GLITCHTIP-SETUP.md for error monitoring setup
#
