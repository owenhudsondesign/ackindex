{
    "title": "Nantucket Town Government PDF Scraper Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "startUrls": {
            "title": "Start URLs",
            "type": "array",
            "description": "URLs to start crawling from",
            "editor": "requestListSources",
            "default": [
                {
                    "url": "https://ackindex.com"
                }
            ]
        },
        "downloadPdfs": {
            "title": "Download and Parse PDFs",
            "type": "boolean",
            "description": "If true, PDFs will be downloaded and parsed. If false, only PDF links will be extracted.",
            "default": true
        },
        "maxCrawlDepth": {
            "title": "Max Crawl Depth",
            "type": "integer",
            "description": "Maximum depth of pages to crawl from start URLs",
            "default": 2,
            "minimum": 0,
            "maximum": 10
        },
        "maxRequests": {
            "title": "Max Requests",
            "type": "integer",
            "description": "Maximum number of pages to crawl",
            "default": 100,
            "minimum": 1
        },
        "proxyConfiguration": {
            "title": "Proxy Configuration",
            "type": "object",
            "description": "Proxy settings for the crawler",
            "editor": "proxy",
            "default": {
                "useApifyProxy": false
            }
        }
    },
    "required": ["startUrls"]
}
