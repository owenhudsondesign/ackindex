{
  "title": "CivicClerk Harvester Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "portalUrl": {
      "title": "Portal URL",
      "type": "string",
      "description": "CivicClerk portal root (e.g., https://nantucketma.portal.civicclerk.com/)",
      "default": "https://nantucketma.portal.civicclerk.com/",
      "editor": "textfield"
    },
    "maxEvents": {
      "title": "Max events to scan",
      "type": "integer",
      "description": "Upper bound on number of event files pages to visit (keeps runs fast)",
      "default": 50,
      "editor": "number"
    }
  },
  "required": ["portalUrl"]
}


