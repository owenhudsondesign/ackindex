{
  "actorSpecification": 1,
  "name": "stagehand-nantucket-scraper",
  "title": "Stagehand Nantucket Government Scraper",
  "description": "AI-powered web scraper using Stagehand to extract content from Nantucket government websites, including PDFs and meeting documents",
  "version": "1.0.0",
  "dockerfile": "./Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Scraped Data",
          "transformation": {
            "fields": [
              "type",
              "url",
              "title",
              "text_length",
              "pdf_count",
              "num_pages",
              "status"
            ]
          }
        }
      }
    }
  }
}

