{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm install -g tsx"
  },
  "deploy": {
    "startCommand": "tsx worker.ts",
    "restartPolicyType": "ALWAYS",
    "environmentVariables": {
      "NODE_VERSION": "20"
    }
  }
}
